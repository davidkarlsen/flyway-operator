{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "patternProperties": {
    "^common$": {
      "description": "Values of the Bitnami common library chart, added by Helm. Not used by this chart.",
      "required": [],
      "type": "object"
    }
  },
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "fullnameOverride": {
      "default": "",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "grafana": {
      "additionalProperties": false,
      "properties": {
        "dashboards": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": false,
              "description": "Opt-in: ship the operator and Migrations dashboards as a ConfigMap (\u003cfullname\u003e-dashboards) with one\nkey per dashboard. See docs/dashboards.md.",
              "title": "enabled",
              "type": "boolean"
            },
            "grafanaDashboard": {
              "additionalProperties": false,
              "properties": {
                "allowCrossNamespaceImport": {
                  "default": true,
                  "description": "Needed when Grafana runs in another namespace. Changing it from true to false is rejected once created; recreate the GrafanaDashboard.",
                  "title": "allowCrossNamespaceImport",
                  "type": "boolean"
                },
                "enabled": {
                  "default": true,
                  "description": "Also render a GrafanaDashboard per dashboard. Only rendered when the cluster serves\ngrafana.integreatly.org/v1beta1; for `helm template` pass\n`--api-versions grafana.integreatly.org/v1beta1`. Use one import path per Grafana: when the\nsidecar loads the ConfigMap, set this to false.",
                  "title": "enabled",
                  "type": "boolean"
                },
                "folder": {
                  "default": "",
                  "description": "Optional Grafana folder.",
                  "title": "folder",
                  "type": "string"
                },
                "instanceSelector": {
                  "additionalProperties": true,
                  "description": "Must match the labels of your Grafana resource. Immutable once created.",
                  "properties": {
                    "matchLabels": {
                      "additionalProperties": true,
                      "properties": {
                        "dashboards": {
                          "default": "grafana",
                          "title": "dashboards",
                          "type": "string"
                        }
                      },
                      "required": [],
                      "title": "matchLabels",
                      "type": "object"
                    }
                  },
                  "required": [],
                  "title": "instanceSelector",
                  "type": "object"
                }
              },
              "required": [],
              "title": "grafanaDashboard",
              "type": "object"
            },
            "labels": {
              "additionalProperties": true,
              "description": "Labels on the ConfigMap; the Grafana sidecar discovers dashboards by grafana_dashboard.\nHelm merges your values into these defaults, so `labels: {}` keeps the label. To remove it, e.g. when\ngrafana-operator imports the dashboards and a sidecar would import them again, set\n`grafana.dashboards.labels.grafana_dashboard: null`.",
              "properties": {
                "grafana_dashboard": {
                  "default": "1",
                  "required": [],
                  "title": "grafana_dashboard",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [],
              "title": "labels",
              "type": "object"
            }
          },
          "required": [],
          "title": "dashboards",
          "type": "object"
        }
      },
      "required": [],
      "title": "grafana",
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "pullPolicy": {
          "default": "IfNotPresent",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ],
          "title": "pullPolicy",
          "type": "string"
        },
        "registry": {
          "default": "ghcr.io",
          "title": "registry",
          "type": "string"
        },
        "repository": {
          "default": "davidkarlsen/flyway-operator",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "0.7.0",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Serve /metrics over HTTPS, protected by Kubernetes authn/authz (TokenReview + SubjectAccessReview).\nScrapers need a ServiceAccount bound to the \u003cfullname\u003e-metrics-reader ClusterRole.",
          "title": "enabled",
          "type": "boolean"
        },
        "port": {
          "default": 8443,
          "title": "port",
          "type": "integer"
        },
        "serviceMonitor": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": false,
              "description": "Opt-in: requires the monitoring.coreos.com/v1 CRDs (Prometheus Operator).\nThe ServiceMonitor is only rendered when the cluster serves that API; if it does not, it is\nskipped (not failed) so `helm template` works without a cluster, and a warning is shown in\nthe install notes. For offline rendering / GitOps without cluster access pass\n`--api-versions monitoring.coreos.com/v1/ServiceMonitor` to `helm template`.",
              "title": "enabled",
              "type": "boolean"
            },
            "interval": {
              "default": "",
              "description": "Scrape interval, e.g. 30s. Empty uses the Prometheus default.",
              "title": "interval",
              "type": "string"
            },
            "labels": {
              "additionalProperties": true,
              "description": "The endpoint sets honorLabels: true so the `namespace` label on the operator's metrics (the\nMigration's namespace) is kept rather than renamed to exported_namespace.\nExtra labels on the ServiceMonitor, e.g. to match a Prometheus serviceMonitorSelector.",
              "required": [],
              "title": "labels",
              "type": "object"
            }
          },
          "required": [],
          "title": "serviceMonitor",
          "type": "object"
        }
      },
      "required": [],
      "title": "metrics",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": true,
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": true,
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "required": [],
      "title": "podSecurityContext",
      "type": "object"
    },
    "prometheusRule": {
      "additionalProperties": false,
      "properties": {
        "additionalLabels": {
          "additionalProperties": true,
          "description": "Extra labels on the PrometheusRule, e.g. to match a Prometheus ruleSelector.",
          "required": [],
          "title": "additionalLabels",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "description": "Opt-in: requires the monitoring.coreos.com/v1 CRDs (Prometheus Operator). Rendered only when the\ncluster serves the PrometheusRule API; for offline rendering pass\n`--api-versions monitoring.coreos.com/v1/PrometheusRule` to `helm template`.\nThe alerts (see docs/metrics.md) use the operator's metrics, so enable metrics too.",
          "title": "enabled",
          "type": "boolean"
        },
        "namespace": {
          "default": "",
          "description": "Namespace of the PrometheusRule. Empty uses the release namespace.",
          "title": "namespace",
          "type": "string"
        }
      },
      "required": [],
      "title": "prometheusRule",
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "properties": {
        "limits": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "default": "500m",
              "required": [],
              "title": "cpu",
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "default": "128Mi",
              "required": [],
              "title": "memory",
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "default": "10m",
              "required": [],
              "title": "cpu",
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "default": "64Mi",
              "required": [],
              "title": "memory",
              "type": [
                "string",
                "number"
              ]
            }
          },
          "required": [],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": true,
      "required": [],
      "title": "securityContext",
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "default": 80,
          "title": "port",
          "type": "integer"
        },
        "type": {
          "default": "ClusterIP",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "title": "type",
          "type": "string"
        }
      },
      "required": [],
      "title": "service",
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "description": "Annotations to add to the service account",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "create": {
          "default": true,
          "description": "Specifies whether a service account should be created",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "The name of the service account to use.\nIf not set and create is true, a name is generated using the fullname template.\nRequired when create is false (rendering fails otherwise, so the operator's\nClusterRole is never bound to the namespace default ServiceAccount).",
          "title": "name",
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    },
    "tolerations": {
      "items": {
        "required": [],
        "type": "object"
      },
      "title": "tolerations",
      "type": "array"
    }
  },
  "required": [],
  "type": "object"
}
